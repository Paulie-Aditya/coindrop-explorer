[Unit]
Description=CoinDrop Explorer Server
After=network.target mysql.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/coindrop-explorer
EnvironmentFile=/home/ubuntu/coindrop-explorer/.env

ExecStart=/home/ubuntu/coindrop-explorer/venv/bin/uvicorn main:app \
          --host 127.0.0.1 \
          --port 8001 \
          --workers 2 \
          --log-level info

Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=coindrop-explorer

[Install]
WantedBy=multi-user.target
