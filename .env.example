# ── Database (same DB as the CoinDrop bot / coindrop-api) ────────────────────
DB_HOST=localhost
DB_USER=coindrop
DB_PASS=yourpassword
DB_NAME=coindrop
DB_POOL_SIZE=10

# ── Shared secret (must match the bot's and coindrop-backend's) ─────────────
# Generate a strong one:  python3 -c "import secrets; print(secrets.token_hex(32))"
EXPLORER_SIGNING_SECRET=change_me_to_a_random_secret

# ── Server ────────────────────────────────────────────────────────────────────
# Public-facing base URL. The bot and coindrop-backend build links as
# {EXPLORER_BASE_URL}/{coin symbol, lowercase}/{tx_hash}?d=<token>
EXPLORER_BASE_URL=https://explorer.coindrop.cc

# ── Admin dashboard (HTTP Basic auth on /admin/stats) ─────────────────────────
ADMIN_USER=admin
ADMIN_PASS=change_me_to_a_random_password

# ── Live tx status (optional explorer API keys) ───────────────────────────────
# Without these the page still works; those chains just show no live status.
#   Etherscan V2: free key covers Ethereum + Polygon; OP/BSC/Base need a paid plan.
#     (Ethereum + Avalanche also work keyless via Routescan.)
#   3xpl (Blockchair's v3 API; key via https://3xpl.com/discord): without a key,
#     Optimism + Tron use the throttled public sandbox. With a key, BSC, Polygon,
#     Base and Solana get live status too.
#   Tronscan: optional; preferred over 3xpl for Tron when set.
#   Solscan: optional; preferred over 3xpl for Solana when set.
ETHERSCAN_API_KEY=
THREEXPL_API_KEY=
TRONSCAN_API_KEY=
SOLSCAN_API_KEY=
